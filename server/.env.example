# AHAMMED SONS WATER SERVICE CRM - Environment Configuration Example
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Atlas or Local)
# For Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ahammed_sons_crm?retryWrites=true&w=majority
# For Local: mongodb://127.0.0.1:27017/service_station
MONGODB_URI=mongodb://127.0.0.1:27017/service_station
# MONGO_URI is also supported as an alias
MONGO_URI=mongodb://127.0.0.1:27017/service_station

# JWT — generate strong random secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — frontend URL (no trailing slash)
CLIENT_ORIGIN=http://localhost:3000

# Twilio (optional — leave blank to disable SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Email — SMTP (optional — use Gmail App Password or Brevo free tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# Set to 'true' to serve React build from Express (single-server deploy)
SERVE_CLIENT=false
